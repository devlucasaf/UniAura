<?xml version="1.0" encoding="UTF-8"?>
<!-- Configuracao Log4j2 -->
<Configuration status="WARN">
    <Appenders>
        <Console name="Console" target="SYSTEM_OUT">
            <PatternLayout pattern="%d{yyyy-MM-dd HH:mm:ss.SSS} %highlight{%-5level} %pid --- [%15.15t] %-40.40c{1.} : [user=%X{sub}, userId=%X{user_id}] %m%n%ex"/>
        </Console>
    </Appenders>
    <Loggers>
        <Root level="INFO">
            <AppenderRef ref="Console"/>
        </Root>
    </Loggers>
</Configuration>
